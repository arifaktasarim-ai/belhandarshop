# ============================================
# VERİTABANI - SUPABASE
# ============================================
# Supabase Dashboard > Project Settings > Database > "Connection String" bölümünden alınır.
# İKİ farklı bağlantı adresine ihtiyacın var:
#
# 1) DATABASE_URL — Uygulamanın normal çalışması için kullanılır (Transaction Pooler, port 6543).
#    Render gibi bir platformda çok sayıda kısa ömürlü bağlantı açıldığından pooler kullanmak zorunludur.
#    Sonuna mutlaka ?pgbouncer=true eklenmelidir (Prisma'nın prepared statement sorunlarını önler).
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[SIFREN]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2) DIRECT_URL — Sadece "prisma migrate" komutları için kullanılır (Direct Connection, port 5432).
#    Pooler, DDL (tablo oluşturma/değiştirme) komutlarını desteklemediği için migration'lar bu adresi kullanır.
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:[SIFREN]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Not: Bölge (eu-central-1 vb.) ve proje referansı (xxxxxxxxxxxx) Supabase projenin kendi bilgilerine göre değişir.
# Şifreni unuttuysan Supabase Dashboard > Project Settings > Database > "Reset Database Password" ile sıfırlayabilirsin.

# JWT
JWT_SECRET="cok-gizli-bir-anahtar-buraya-yazin"
JWT_EXPIRES_IN="7d"

# Cloudinary (Dosya Yükleme)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Sunucu
# NOT: Render.com bu değeri otomatik olarak enjekte eder, .env'deki değer sadece yerel geliştirme içindir.
PORT=5000

# Frontend'in barındırıldığı adres (CORS için). Render'da frontend servisinin URL'i, örn:
# CLIENT_URL="https://belhandar-frontend.onrender.com"
CLIENT_URL="http://localhost:3000"

# Kritik stok eşiği (varsayılan)
CRITICAL_STOCK_THRESHOLD=10
